# ==========================================================================
# EMORPHOSIS — Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para ".env" e preencha os valores localmente.
# NUNCA commite o arquivo ".env" com valores reais no Git.
# ==========================================================================

# --- 1. Deploy FTPS na Hostinger (scripts/deploy_ftp.py) ---
FTP_HOST=
FTP_PORT=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=

# --- 2. Banco de Dados MySQL (api/db.example.php & scripts/deploy_ftp.py) ---
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# --- 3. Segurança & Notificações dos Endpoints PHP (api/config_loader.php) ---
ADMIN_DROP_TOKEN=
ADMIN_NOTIFY_EMAIL=
DROP_RADAR_SECRET=
PRESENCE_SID_SALT=
PRESENCE_IP_SALT=

# --- 4. Anthropic Claude API (opcional — scripts/drops_ai_parser.py) ---
ANTHROPIC_API_KEY=

# --- 5. Notion Hub (scripts/notion_hub.py) ---
NOTION_API_KEY=
NOTION_ROOT_PAGE_ID=
NOTION_DEV_PAGE_ID=
NOTION_TASKS_DB_ID=
NOTION_TASKS_DS_ID=
NOTION_IDEAS_DB_ID=
NOTION_IDEAS_DS_ID=

